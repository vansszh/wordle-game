# Supabase — get these from your Supabase project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database — Drizzle uses this for migrations and admin operations.
# In Supabase dashboard, this is the "Connection string" under Settings > Database (use the "Transaction" pooler).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Public app URL (used by OAuth callback and share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
